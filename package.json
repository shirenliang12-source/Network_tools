{
  "name": "netops-console",
  "version": "1.1.0",
  "private": true,
  "description": "纯网络运维与故障排除工具平台 - 扫描、诊断、SNMP、终端、抓包与流量分析",
  "main": "server/index.js",
  "bin": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node tools/smoke.js && node tools/tpl-check.js && node tools/dupkey-check.js && node tools/front-check.js",
    "smoke": "node tools/smoke.js",
    "tpl": "node tools/tpl-check.js",
    "dupkey": "node tools/dupkey-check.js",
    "front": "node tools/front-check.js",
    "verify:ui": "node tools/verify-ui.js",
    "e2e": "node tools/e2e.js",
    "pcap": "node tools/pcap-smoke.js",
    "scan": "node tools/scan-smoke.js",
    "diag": "node tools/netdiag-smoke.js",
    "toolbox": "node tools/toolbox-smoke.js",
    "deep": "node tools/deep-tools-smoke.js",
    "wifi": "node tools/wifi-smoke.js",
    "migrate": "node tools/migrate.js",
    "build": "npm run build:binaries",
    "build:binaries": "npm run build:win && npm run build:linux && npm run build:mac",
    "build:win": "pkg . --target node18-win-x64 --output dist/bin/netops-console-windows-x64.exe --compress GZip",
    "build:linux": "pkg . --target node18-linux-x64 --output dist/bin/netops-console-linux-x64 --compress GZip",
    "build:mac": "pkg . --target node18-macos-x64 --output dist/bin/netops-console-macos-x64 --compress GZip && pkg . --target node18-macos-arm64 --output dist/bin/netops-console-macos-arm64 --compress GZip --no-bytecode --public --public-packages \"*\""
  },
  "pkg": {
    "scripts": [
      "server/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "server/oui.json",
      "node_modules/vue/dist/**/*",
      "node_modules/echarts/dist/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist",
    "outfile": "netops-console-%s"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "net-snmp": "^3.29.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "ssh2": "^1.17.0",
    "vue": "^3.5.43",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vue/compiler-dom": "^3.5.43",
    "@yao-pkg/pkg": "^5.16.1"
  }
}
