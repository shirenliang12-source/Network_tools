[Unit]
Description=NetOps Console - Network Operations Toolkit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netops-console
Group=netops-console
WorkingDirectory=/opt/netops-console
ExecStart=/opt/netops-console/netops-console
Environment=HOST=0.0.0.0
Environment=PORT=8787
Environment=AUTO_INSTALL_TOOLS=0
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
